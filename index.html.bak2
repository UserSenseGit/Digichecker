<!DOCTYPE html>
<html lang="nl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Digichecker</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        primary: '#18181b',
                        primaryLight: '#f4f4f5',
                    }
                }
            }
        }

        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        .kanban-board {
            display: flex;
            align-items: flex-start;
            gap: 1.5rem;
            overflow-x: auto;
            padding-bottom: 1rem;
            min-height: calc(100vh - 120px);
        }

        .kanban-column {
            min-width: 320px;
            width: 320px;
            display: flex;
            flex-direction: column;
            max-height: calc(100vh - 140px);
        }

        #col-upcoming .kanban-column-header {
            border-top: 3px solid #71717a;
        }

        #col-atelier .kanban-column-header {
            border-top: 3px solid #f59e0b;
        }

        #col-archive .kanban-column-header {
            border-top: 3px solid #3f3f46;
        }

        #col-archive.archive-collapsed {
            min-width: 72px;
            width: 72px;
        }

        #col-archive.archive-collapsed .kanban-cards-container,
        #col-archive.archive-collapsed .archive-label {
            display: none;
        }

        #col-archive.archive-collapsed .archive-title {
            flex-direction: column;
        }

        #col-done .kanban-column-header {
            border-top: 3px solid #10b981;
        }

        .kanban-cards-container {
            padding: 0.75rem;
            overflow-y: auto;
            flex-grow: 1;
            min-height: 100px;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .kanban-card {
            transition: all 0.2s ease;
            position: relative;
        }

        .kanban-card:hover {
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            border-color: #52525b;
        }

        .kanban-card.is-dragging {
            opacity: 0.5;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
            transform: scale(1.02);
            cursor: grabbing;
        }

        .custom-checkbox input:checked+div {
            background-color: #10b981;
            border-color: #10b981;
        }

        .custom-checkbox input:checked+div svg {
            display: block;
        }

        .item-checked {
            text-decoration: line-through;
            color: #71717a;
        }

        .dark .item-checked {
            color: #52525b;
        }

        .loader {
            border: 3px solid #3f3f46;
            border-top: 3px solid #e4e4e7;
            border-radius: 50%;
            width: 24px;
            height: 24px;
            animation: spin 1s linear infinite;
            display: inline-block;
        }

        .dark .loader {
            border-color: #27272a;
            border-top-color: #fafafa;
        }

        @keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        .kanban-cards-container::-webkit-scrollbar,
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        .kanban-cards-container::-webkit-scrollbar-track,
        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }

        .kanban-cards-container::-webkit-scrollbar-thumb,
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #d4d4d8;
            border-radius: 2px;
        }

        .dark .kanban-cards-container::-webkit-scrollbar-thumb,
        .dark .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #3f3f46;
        }

        .modal-overlay {
            background-color: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(4px);
        }
    
        .label-aframes { border-left: 4px solid #18181b; }
        .label-axor    { border-left: 4px solid #2563eb; }
        .label-extern  { border-left: 4px solid #dc2626; }
        .dark .label-aframes { border-left-color: #e4e4e7; }
        .label-chip { display:inline-flex; align-items:center; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; padding:2px 6px; border-radius:2px; color:#fff; }
        .label-chip.aframes { background:#18181b; }
        .dark .label-chip.aframes { background:#e4e4e7; color:#18181b; }
        .label-chip.axor { background:#2563eb; }
        .label-chip.extern { background:#dc2626; }
    
        /* patch: modals boven projectmodal, sleep-handvat */
        #stagingModal, #reviewModal { z-index: 70 !important; }
        #processingModal { z-index: 80 !important; }
        .cl-grip { cursor: grab; touch-action: none; }
        .cl-main.is-sorting, .cl-sub.is-sorting { opacity: .5; }
    </style>
</head>

<body class="bg-zinc-100 text-zinc-900 dark:bg-black dark:text-zinc-200 transition-colors duration-200">

    <div class="min-h-screen flex flex-col">
        <!-- Header -->
        <header
            class="bg-white dark:bg-zinc-950 border-b border-zinc-200 dark:border-zinc-800 sticky top-0 z-10 shadow-sm transition-colors duration-200">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-900 p-2 rounded-md shadow-sm">
                        <i class="fa-solid fa-list-check text-xl"></i>
                    </div>
                    <h1 class="text-xl font-bold text-zinc-900 dark:text-white hidden sm:block">Digi<span
                            class="font-normal text-zinc-500 dark:text-zinc-400">checker</span></h1>
                </div>
                <div class="flex items-center gap-3">
                    <button id="logoutBtn" title="Uitloggen"
                        class="text-zinc-500 hover:text-zinc-800 dark:text-zinc-400 dark:hover:text-white p-2 rounded-md hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors">
                        <i class="fa-solid fa-right-from-bracket text-lg"></i>
                    </button>
                    <button id="themeToggle"
                        class="text-zinc-500 hover:text-zinc-800 dark:text-zinc-400 dark:hover:text-white p-2 rounded-md hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors">
                        <i class="fa-solid fa-moon text-lg" id="themeIcon"></i>
                    </button>

                    <button onclick="openStagingModal()"
                        class="bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 hover:bg-zinc-800 dark:hover:bg-zinc-200 px-4 py-2 rounded-md shadow-sm font-medium transition-colors flex items-center gap-2 text-sm">
                        <i class="fa-solid fa-plus"></i>
                        <span>Nieuw Project</span>
                    </button>
                </div>
            </div>
        </header>

        <!-- Main Content (Kanban Board) -->
        <main class="flex-grow p-4 sm:p-6 max-w-full overflow-hidden flex flex-col">
            <!-- Loading Indicator -->
            <div id="boardLoading"
                class="flex-grow flex flex-col items-center justify-center text-zinc-500 dark:text-zinc-400 gap-3">
                <div class="loader"></div>
                <p>Projecten laden...</p>
            </div>

            <!-- The Board -->
            <div id="kanbanBoard" class="kanban-board hidden">
                <!-- Column: Aankomend -->
                <div class="kanban-column bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-md"
                    id="col-upcoming" data-status="upcoming">
                    <div
                        class="kanban-column-header p-3 font-semibold text-zinc-900 dark:text-white flex justify-between items-center bg-white dark:bg-zinc-900 border-b border-zinc-200 dark:border-zinc-800 rounded-t-md">
                        <div class="flex items-center gap-2">
                            <span>Aankomend</span>
                            <span
                                class="bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 text-xs px-2 py-1 rounded-sm font-bold count-badge">0</span>
                        </div>
                    </div>
                    <div class="kanban-cards-container" data-status="upcoming"></div>
                </div>

                <!-- Column: Atelier -->
                <div class="kanban-column bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-md"
                    id="col-atelier" data-status="atelier">
                    <div
                        class="kanban-column-header p-3 font-semibold text-zinc-900 dark:text-white flex justify-between items-center bg-white dark:bg-zinc-900 border-b border-zinc-200 dark:border-zinc-800 rounded-t-md">
                        <div class="flex items-center gap-2">
                            <span>Atelier</span>
                            <span
                                class="bg-amber-100 dark:bg-amber-900/40 text-amber-700 dark:text-amber-500 text-xs px-2 py-1 rounded-sm font-bold count-badge">0</span>
                        </div>
                    </div>
                    <div class="kanban-cards-container" data-status="atelier"></div>
                </div>

                <!-- Column: Gereed -->
                <div class="kanban-column bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-md"
                    id="col-done" data-status="done">
                    <div
                        class="kanban-column-header p-3 font-semibold text-zinc-900 dark:text-white flex justify-between items-center bg-white dark:bg-zinc-900 border-b border-zinc-200 dark:border-zinc-800 rounded-t-md">
                        <div class="flex items-center gap-2">
                            <span>Gereed</span>
                            <span
                                class="bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-500 text-xs px-2 py-1 rounded-sm font-bold count-badge">0</span>
                        </div>
                    </div>
                    <div class="kanban-cards-container" data-status="done"></div>
                </div>

                <!-- Column: Archief -->
                <div class="kanban-column bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-md"
                    id="col-archive" data-status="archive">
                    <div onclick="toggleArchive()" title="Archief in- of uitklappen"
                        class="kanban-column-header p-3 font-semibold text-zinc-900 dark:text-white flex justify-between items-center bg-white dark:bg-zinc-900 border-b border-zinc-200 dark:border-zinc-800 rounded-t-md cursor-pointer select-none">
                        <div class="archive-title flex items-center gap-2">
                            <i id="archiveChevron" class="fa-solid fa-chevron-down text-xs text-zinc-400"></i>
                            <span class="archive-label">Archief</span>
                            <span
                                class="bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 text-xs px-2 py-1 rounded-sm font-bold count-badge">0</span>
                        </div>
                    </div>
                    <div class="kanban-cards-container" data-status="archive"></div>
                </div>
            </div>
        </main>
    </div>

    <div id="loginScreen" class="fixed inset-0 z-[90] bg-zinc-100 dark:bg-black flex items-center justify-center p-4 hidden">
        <form id="loginForm" class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-md shadow-2xl p-6 w-full max-w-sm space-y-4">
            <h2 class="text-xl font-bold text-zinc-900 dark:text-white">Digi<span class="font-normal text-zinc-500 dark:text-zinc-400">checker</span></h2>
            <input id="loginEmail" type="email" placeholder="E-mailadres" autocomplete="username" required class="w-full p-2 border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white rounded-md outline-none focus:ring-1 focus:ring-zinc-900 dark:focus:ring-white">
            <input id="loginPassword" type="password" placeholder="Wachtwoord" autocomplete="current-password" required class="w-full p-2 border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white rounded-md outline-none focus:ring-1 focus:ring-zinc-900 dark:focus:ring-white">
            <p id="loginError" class="text-sm text-red-500 hidden"></p>
            <button id="loginBtn" type="submit" class="w-full bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 hover:bg-zinc-800 dark:hover:bg-zinc-200 px-4 py-2.5 rounded-md font-medium disabled:opacity-50">Inloggen</button>
        </form>
    </div>

    <!-- Staging Modal -->
    <div id="stagingModal"
        class="fixed inset-0 modal-overlay z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-300">
        <div
            class="bg-white dark:bg-zinc-900 rounded-md border border-zinc-200 dark:border-zinc-800 shadow-2xl p-6 max-w-2xl w-full mx-4 transform scale-95 transition-transform duration-300 flex flex-col">
            <div class="flex justify-between items-center mb-6">
                <h2 id="stagingTitle" class="text-xl font-bold text-zinc-900 dark:text-white">Nieuw Project Toevoegen</h2>
                <button onclick="hideModal('stagingModal')"
                    class="text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-300">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>
            </div>

            <p class="text-sm text-zinc-500 dark:text-zinc-400 mb-4">Voeg één of meerdere foto's toe van de
                projectfiches.</p>

            <div id="stagingImageContainer" class="flex gap-4 overflow-x-auto custom-scrollbar pb-4 min-h-[160px]">
                <!-- Images injected here -->
            </div>

            <div class="mt-6 flex flex-wrap gap-3">
                <input id="stagingCameraInput" type="file" accept="image/*" capture="environment" class="hidden">
                <input id="stagingFileInput" type="file" accept="image/*" multiple class="hidden">

                <button onclick="document.getElementById('stagingCameraInput').click()"
                    class="flex-1 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 border border-zinc-200 dark:border-zinc-700 text-zinc-900 dark:text-zinc-100 px-4 py-3 rounded-md font-medium transition-colors flex items-center justify-center gap-2">
                    <i class="fa-solid fa-camera"></i> Maak Foto
                </button>
                <button onclick="document.getElementById('stagingFileInput').click()"
                    class="flex-1 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 border border-zinc-200 dark:border-zinc-700 text-zinc-900 dark:text-zinc-100 px-4 py-3 rounded-md font-medium transition-colors flex items-center justify-center gap-2">
                    <i class="fa-regular fa-image"></i> Kies Bestand
                </button>
            </div>

            <div class="mt-6 pt-4 border-t border-zinc-200 dark:border-zinc-800 flex justify-end">
                <button id="btnEmptyProject" onclick="createEmptyProject()"
                    class="mr-3 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 border border-zinc-200 dark:border-zinc-700 text-zinc-900 dark:text-zinc-100 px-4 py-2.5 rounded-md font-medium transition-colors flex items-center gap-2">
                    <i class="fa-regular fa-file"></i>
                    <span>Zonder fiche aanmaken</span>
                </button>
                <button id="btnProcessImages"
                    class="bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 hover:bg-zinc-800 dark:hover:bg-zinc-200 px-6 py-2.5 rounded-md font-bold shadow-sm transition-colors flex items-center gap-2 opacity-50 cursor-not-allowed"
                    disabled>
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                    <span>Verwerk met AI</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Processing AI Modal -->
    <div id="processingModal"
        class="fixed inset-0 modal-overlay z-[60] flex items-center justify-center hidden opacity-0 transition-opacity duration-300">
        <div
            class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-md shadow-2xl p-8 max-w-sm mx-4 w-full text-center transform scale-95 transition-transform duration-300 flex flex-col items-center">
            <div class="loader w-12 h-12 border-4 mb-4"></div>
            <h3 class="text-lg font-bold text-zinc-900 dark:text-white">Fiche(s) Verwerken...</h3>
            <p class="text-zinc-500 dark:text-zinc-400 mt-2 text-sm">AI leest de gegevens en bouwt de checklist op
                inclusief subitems.</p>
        </div>
    </div>

    <!-- Review New Project Modal -->
    <div id="reviewModal"
        class="fixed inset-0 modal-overlay z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-300">
        <div
            class="bg-white dark:bg-zinc-900 rounded-md border border-zinc-200 dark:border-zinc-800 shadow-2xl w-full max-w-2xl mx-4 overflow-hidden transform scale-95 transition-transform duration-300 flex flex-col max-h-[90vh]">

            <div
                class="p-4 border-b border-zinc-200 dark:border-zinc-800 flex justify-between items-center bg-zinc-50 dark:bg-zinc-950">
                <h2 class="text-lg font-bold text-zinc-900 dark:text-white">Controleer Project</h2>
                <button onclick="hideModal('reviewModal')"
                    class="text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-300 p-1">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>
            </div>

            <div class="p-6 overflow-y-auto custom-scrollbar flex-grow bg-white dark:bg-zinc-900">
                <div id="reviewImagesContainer" class="mb-6 flex gap-3 overflow-x-auto custom-scrollbar pb-2">
                    <!-- Injected via JS -->
                </div>

                <div class="mb-4 flex flex-col sm:flex-row gap-4">
                    <div class="flex-grow">
                        <label
                            class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-1">Projecttitel</label>
                        <input type="text" id="reviewTitle"
                            class="w-full p-2 border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white rounded-md focus:ring-1 focus:ring-zinc-900 dark:focus:ring-white font-bold outline-none">
                    </div>
                    <div class="sm:w-32">
                        <label class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-1">Week
                            oplevering</label>
                        <input type="number" id="reviewWeek" placeholder="Bv. 42"
                            class="w-full p-2 border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white rounded-md focus:ring-1 focus:ring-zinc-900 dark:focus:ring-white outline-none">
                    </div>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-1">Label</label>
                    <select id="reviewLabel"
                        class="w-full p-2 border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white rounded-md outline-none focus:ring-1 focus:ring-zinc-900 dark:focus:ring-white">
                        <option value="aframes">⚫ A-Frames</option>
                        <option value="axor">🔵 Axor / A-Struc</option>
                        <option value="extern">🔴 Extern</option>
                    </select>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-2">Checklist
                        (Bewerkbaar)</label>
                    <div id="reviewChecklist"
                        class="space-y-3 bg-zinc-50 dark:bg-zinc-950 p-4 rounded-md border border-zinc-200 dark:border-zinc-800">
                        <!-- Dynamic inputs -->
                    </div>
                    <button onclick="addReviewItem()"
                        class="mt-3 text-sm text-zinc-600 dark:text-zinc-400 font-medium hover:text-zinc-900 dark:hover:text-white flex items-center gap-1 border border-zinc-300 dark:border-zinc-700 px-3 py-1 rounded-md">
                        <i class="fa-solid fa-plus"></i> Hoofdpunt toevoegen
                    </button>
                </div>
            </div>

            <div
                class="p-4 border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950 flex justify-end gap-3">
                <button onclick="hideModal('reviewModal')"
                    class="px-4 py-2 border border-zinc-300 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 rounded-md hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors">Annuleren</button>
                <button id="btnSaveNewProject"
                    class="bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 hover:bg-zinc-800 dark:hover:bg-zinc-200 px-6 py-2 rounded-md font-medium shadow flex items-center gap-2 transition-colors">
                    <i class="fa-solid fa-check"></i>
                    <span>Opslaan op Bord</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Active Project Details Modal -->
    <div id="projectModal"
        class="fixed inset-0 modal-overlay z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-300 p-4 sm:p-6">
        <div
            class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-md shadow-2xl w-full max-w-6xl h-full max-h-[90vh] overflow-hidden flex flex-col transform scale-95 transition-transform duration-300">

            <!-- Header -->
            <div
                class="p-4 sm:px-6 border-b border-zinc-200 dark:border-zinc-800 flex justify-between items-start bg-zinc-50 dark:bg-zinc-950 z-10 flex-shrink-0">
                <div class="flex-grow pr-4">
                    <h2 id="modalProjectTitle"
                        class="text-xl sm:text-2xl font-bold text-zinc-900 dark:text-white break-words leading-tight mb-2">
                        Project Titel</h2>
                    <div class="flex flex-wrap items-center gap-3">
                        <select id="modalProjectStatus"
                            class="text-sm font-medium rounded-md border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white shadow-sm focus:ring-1 focus:ring-zinc-500 outline-none px-2 py-1.5">
                            <option value="upcoming">Aankomend</option>
                            <option value="atelier">Atelier</option>
                            <option value="done">Gereed</option>
                            <option value="archive">Archief</option>
                        </select>

                        <select id="modalProjectLabel"
                            class="text-sm font-medium rounded-md border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white shadow-sm focus:ring-1 focus:ring-zinc-500 outline-none px-2 py-1.5">
                            <option value="">Geen label</option>
                            <option value="aframes">⚫ A-Frames</option>
                            <option value="axor">🔵 Axor / A-Struc</option>
                            <option value="extern">🔴 Extern</option>
                        </select>

                        <div
                            class="flex items-center border border-zinc-300 dark:border-zinc-700 rounded-md overflow-hidden bg-white dark:bg-zinc-800">
                            <span
                                class="px-2 py-1.5 text-sm bg-zinc-100 dark:bg-zinc-900 text-zinc-600 dark:text-zinc-400 border-r border-zinc-300 dark:border-zinc-700 font-medium">Week
                                oplevering</span>
                            <input type="number" id="modalProjectWeek"
                                class="w-16 p-1.5 text-sm bg-transparent border-none text-zinc-900 dark:text-white text-center focus:ring-0 outline-none"
                                placeholder="-">
                        </div>

                        <span id="modalProjectProgress"
                            class="text-sm text-zinc-600 dark:text-zinc-300 font-medium bg-zinc-200 dark:bg-zinc-800 px-2 py-1.5 rounded-md border border-zinc-300 dark:border-zinc-700">0/0</span>
                    </div>
                </div>
                <div class="flex gap-1 sm:gap-2">
                    <button id="btnDeleteProject"
                        class="text-red-500 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300 p-2.5 rounded-md hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors"
                        title="Verwijder Project">
                        <i class="fa-regular fa-trash-can text-lg"></i>
                    </button>
                    <button onclick="hideModal('projectModal')"
                        class="text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-200 p-2.5 rounded-md hover:bg-zinc-200 dark:hover:bg-zinc-800 transition-colors">
                        <i class="fa-solid fa-xmark text-xl"></i>
                    </button>
                </div>
            </div>

            <!-- Content Split View -->
            <div class="flex-grow flex flex-col lg:flex-row overflow-hidden min-h-0 bg-white dark:bg-zinc-900">

                <!-- Left/Top: Checklist -->
                <div
                    class="w-full lg:w-1/2 h-[50%] lg:h-full p-4 sm:p-6 overflow-y-auto custom-scrollbar flex flex-col min-h-0 border-b lg:border-b-0 lg:border-r border-zinc-200 dark:border-zinc-800">
                    <div class="flex justify-between items-center mb-4">
                        <div class="flex items-center gap-3">
                            <h3 class="font-bold text-zinc-900 dark:text-white text-lg">Checklist</h3>
                            <button onclick="openStagingModalForProject()"
                                class="text-sm text-zinc-700 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white flex items-center gap-1 font-medium bg-zinc-100 dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700 px-3 py-1.5 rounded-md transition-colors">
                                <i class="fa-solid fa-camera"></i> Fiche toevoegen
                            </button>
                        </div>
                        <button onclick="addNewMainItemToLiveProject()"
                            class="text-sm text-zinc-700 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white flex items-center gap-1 font-medium bg-zinc-100 dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700 px-3 py-1.5 rounded-md transition-colors">
                            <i class="fa-solid fa-plus"></i> Hoofdpunt
                        </button>
                    </div>

                    <div id="liveChecklist" class="space-y-2 flex-grow pb-8">
                        <!-- Checkboxes injected here -->
                    </div>
                </div>

                <!-- Right/Bottom: Images -->
                <div
                    class="w-full lg:w-1/2 h-[50%] lg:h-full bg-zinc-100 dark:bg-black p-4 flex flex-col relative min-h-0">
                    <div
                        class="absolute top-2 right-2 bg-black/70 text-white px-2 py-1 rounded-sm text-xs backdrop-blur-sm z-10 pointer-events-none font-medium border border-zinc-700">
                        Originele Fiches
                    </div>
                    <div id="modalProjectImagesContainer"
                        class="flex-grow overflow-y-auto custom-scrollbar flex flex-col gap-4 items-center rounded-md pb-4">
                        <!-- Images injected here -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Notification Toast -->
    <div id="toast"
        class="fixed bottom-4 right-4 bg-zinc-900 dark:bg-zinc-800 text-white px-4 py-3 rounded-md shadow-lg transform transition-transform duration-300 translate-y-20 opacity-0 z-[100] flex items-center gap-3 font-medium border border-zinc-700 dark:border-zinc-600">
        <i class="fa-solid fa-circle-info text-zinc-300" id="toastIcon"></i>
        <span id="toastMessage">Bericht</span>
    </div>

    <!-- Custom Dialog Modal -->
    <div id="customDialogModal"
        class="fixed inset-0 modal-overlay z-[100] flex items-center justify-center hidden opacity-0 transition-opacity duration-300">
        <div
            class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-md shadow-2xl p-6 max-w-sm mx-4 w-full transform scale-95 transition-transform duration-300 flex flex-col">
            <h3 id="dialogTitle" class="text-lg font-bold text-zinc-900 dark:text-white mb-2">Titel</h3>
            <p id="dialogMessage" class="text-zinc-500 dark:text-zinc-400 text-sm mb-4 hidden">Bericht</p>
            <input type="text" id="dialogInput"
                class="hidden w-full p-2 border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white rounded-md focus:ring-1 focus:ring-zinc-900 dark:focus:ring-white outline-none mb-4">
            <div class="flex justify-end gap-3 mt-2">
                <button id="btnDialogCancel"
                    class="px-4 py-2 border border-zinc-300 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 rounded-md hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors text-sm font-medium">Annuleren</button>
                <button id="btnDialogConfirm"
                    class="bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 hover:bg-zinc-800 dark:hover:bg-zinc-200 px-4 py-2 rounded-md text-sm font-medium shadow transition-colors">Bevestigen</button>
            </div>
        </div>
    </div>

    <!-- Template for Kanban Card -->
    <!-- compact-card -->
    <template id="kanbanCardTemplate">
        <div class="kanban-card group bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-md px-3 py-2 cursor-pointer"
            draggable="true">
            <div class="flex items-center gap-2">
                <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 text-sm leading-snug break-words card-title flex-grow min-w-0"></h3>
                <span class="text-xs font-bold text-zinc-800 dark:text-zinc-100 bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 px-2 py-0.5 rounded-sm card-week-badge hidden shrink-0"></span>
                <span class="label-chip card-label-chip hidden shrink-0"></span>
            </div>
            <div class="flex items-center gap-2 mt-2">
                <div class="flex-grow bg-zinc-100 dark:bg-zinc-800 rounded-sm h-1.5 overflow-hidden">
                    <div class="bg-zinc-800 dark:bg-zinc-300 h-1.5 rounded-sm transition-all duration-500 card-progress-bar"
                        style="width: 0%"></div>
                </div>
                <span class="text-[10px] font-medium text-zinc-500 dark:text-zinc-400 card-progress-text shrink-0">0/0</span>
            </div>
        </div>
    </template>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInWithEmailAndPassword, signOut, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, addDoc, updateDoc, deleteDoc, doc, onSnapshot, query, serverTimestamp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";
        import { getAnalytics } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-analytics.js";

        const firebaseConfig = {
            apiKey: "AIzaSyAfYrAWy_yVsEpoBYnudMInbEVjG4gtdzY",
            authDomain: "digichecker-ae316.firebaseapp.com",
            projectId: "digichecker-ae316",
            storageBucket: "digichecker-ae316.firebasestorage.app",
            messagingSenderId: "96092573104",
            appId: "1:96092573104:web:c441d67e6a31b215495a75",
            measurementId: "G-4TPGH8N5PZ"
        };

        const WORKSPACE_ID = 'a-frames';
        const app = initializeApp(firebaseConfig);
        const db = getFirestore(app);
        const auth = getAuth(app);
        const analytics = getAnalytics(app);
        const projectsCol = () => collection(db, 'workspaces', WORKSPACE_ID, 'projects');
        const projectDoc = (id) => doc(db, 'workspaces', WORKSPACE_ID, 'projects', id);
        let unsubscribeProjects = null;

        let currentUser = null;
        let projects = [];
        let activeProject = null;

        let stagingImagesBase64 = [];
        let pendingProjectData = null;
        let stagingTargetProjectId = null;
        const LABELS = { aframes: 'A-Frames', axor: 'Axor / A-Struc', extern: 'Extern' };
        const esc = (s) => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
        const STEEKRUBBER = 'Steekrubber';
        const hasSteekrubber = (list) => list.some(i => (i.text || '').trim().toLowerCase() === STEEKRUBBER.toLowerCase());
        const newSteekrubberItem = () => ({ id: crypto.randomUUID(), text: STEEKRUBBER, checked: false, subitems: [] });

        onAuthStateChanged(auth, (user) => {
            currentUser = user;
            if (user) {
                document.getElementById('loginScreen').classList.add('hidden');
                document.getElementById('boardLoading').classList.remove('hidden');
                loadProjects();
            } else {
                if (unsubscribeProjects) { unsubscribeProjects(); unsubscribeProjects = null; }
                projects = []; activeProject = null;
                document.getElementById('boardLoading').classList.add('hidden');
                document.getElementById('kanbanBoard').classList.add('hidden');
                document.getElementById('loginScreen').classList.remove('hidden');
            }
        });

        document.getElementById('loginForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const err = document.getElementById('loginError');
            const btn = document.getElementById('loginBtn');
            err.classList.add('hidden');
            btn.disabled = true;
            try {
                await signInWithEmailAndPassword(auth,
                    document.getElementById('loginEmail').value.trim(),
                    document.getElementById('loginPassword').value);
            } catch (error) {
                err.textContent = 'Inloggen mislukt: controleer e-mail en wachtwoord.';
                err.classList.remove('hidden');
            } finally { btn.disabled = false; }
        });

        document.getElementById('logoutBtn').addEventListener('click', () => signOut(auth));





        setupEventListeners();

        const themeIcon = document.getElementById('themeIcon');
        function updateThemeIcon() {
            const dark = document.documentElement.classList.contains('dark');
            themeIcon.classList.toggle('fa-sun', dark);
            themeIcon.classList.toggle('fa-moon', !dark);
        }
        updateThemeIcon();
        document.getElementById('themeToggle').addEventListener('click', () => {
            document.documentElement.classList.toggle('dark');
            localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light');
            updateThemeIcon();
        });

        function updateArchiveChevron() {
            const collapsed = document.getElementById('col-archive').classList.contains('archive-collapsed');
            const ic = document.getElementById('archiveChevron');
            ic.classList.toggle('fa-chevron-down', !collapsed);
            ic.classList.toggle('fa-chevron-right', collapsed);
        }
        window.toggleArchive = function () {
            const collapsed = document.getElementById('col-archive').classList.toggle('archive-collapsed');
            localStorage.setItem('archiveCollapsed', collapsed ? '1' : '0');
            updateArchiveChevron();
        };
        if (localStorage.getItem('archiveCollapsed') === '1') {
            document.getElementById('col-archive').classList.add('archive-collapsed');
        }
        updateArchiveChevron();

        function setupEventListeners() {
            const camInput = document.getElementById('stagingCameraInput');
            const fileInput = document.getElementById('stagingFileInput');

            const handleFiles = (event) => {
                const files = event.target.files;
                if (!files || files.length === 0) return;
                Array.from(files).forEach(file => {
                    compressImage(file, (base64) => {
                        stagingImagesBase64.push(base64);
                        renderStagingImages();
                    });
                });
                event.target.value = '';
            };

            camInput.addEventListener('change', handleFiles);
            fileInput.addEventListener('change', handleFiles);

            document.getElementById('btnProcessImages').addEventListener('click', processStagingImages);
            document.getElementById('btnSaveNewProject').addEventListener('click', saveNewProjectToDB);
            document.getElementById('btnDeleteProject').addEventListener('click', deleteActiveProject);

            document.getElementById('modalProjectStatus').addEventListener('change', (e) => {
                if (activeProject && activeProject.status !== e.target.value) {
                    updateProjectField(activeProject.id, { status: e.target.value });
                }
            });

            document.getElementById('modalProjectLabel').addEventListener('change', (e) => {
                if (activeProject && (activeProject.label || '') !== e.target.value) {
                    const fields = { label: e.target.value };
                    if (e.target.value === 'extern' && !hasSteekrubber(activeProject.checklist || [])) {
                        fields.checklist = [...(activeProject.checklist || []), newSteekrubberItem()];
                    }
                    updateProjectField(activeProject.id, fields);
                }
            });

            document.getElementById('reviewLabel').addEventListener('change', (e) => {
                if (e.target.value === 'extern' && pendingProjectData && !hasSteekrubber(pendingProjectData.checklist)) {
                    pendingProjectData.checklist.push(newSteekrubberItem());
                    renderReviewChecklist();
                }
            });

            document.getElementById('modalProjectWeek').addEventListener('change', (e) => {
                if (activeProject && activeProject.weekNumber !== e.target.value) {
                    updateProjectField(activeProject.id, { weekNumber: e.target.value });
                }
            });

            document.querySelectorAll('.modal-overlay').forEach(overlay => {
                overlay.addEventListener('click', (e) => {
                    if (e.target === overlay) hideModal(overlay.id);
                });
            });
        }

        async function updateProjectField(projectId, fields) {
            if (!currentUser) return;
            try {
                await updateDoc(projectDoc(projectId), fields);
            } catch (e) { showToast("Fout bij updaten", "error"); }
        }

        function loadProjects() {
            if (!currentUser) return;
            const q = query(projectsCol());
            if (unsubscribeProjects) unsubscribeProjects();
            unsubscribeProjects = onSnapshot(q, (snapshot) => {
                projects = [];
                snapshot.forEach((doc) => projects.push({ id: doc.id, ...doc.data() }));
                projects.sort((a, b) => (b.createdAt?.toMillis() || Date.now()) - (a.createdAt?.toMillis() || Date.now()));

                renderBoard();

                if (activeProject) {
                    const updatedActive = projects.find(p => p.id === activeProject.id);
                    if (updatedActive) {
                        activeProject = updatedActive;
                        renderActiveProjectImages();
                        renderActiveProjectLiveChecklist();
                        document.getElementById('modalProjectStatus').value = activeProject.status || 'upcoming';
                        document.getElementById('modalProjectWeek').value = activeProject.weekNumber || '';
                        document.getElementById('modalProjectLabel').value = activeProject.label || '';
                    } else {
                        hideModal('projectModal');
                    }
                }
                document.getElementById('boardLoading').classList.add('hidden');
                document.getElementById('kanbanBoard').classList.remove('hidden');
            }, (error) => {
                console.error("Firestore fout:", error);
                document.getElementById('boardLoading').classList.add('hidden');
                document.getElementById('kanbanBoard').classList.remove('hidden');
                showToast("Database-fout: " + error.code, "error");
            });
        }

        function renderBoard() {
            const containers = {
                'upcoming': document.querySelector('#col-upcoming .kanban-cards-container'),
                'atelier': document.querySelector('#col-atelier .kanban-cards-container'),
                'done': document.querySelector('#col-done .kanban-cards-container'),
                'archive': document.querySelector('#col-archive .kanban-cards-container')
            };
            const counts = { 'upcoming': 0, 'atelier': 0, 'done': 0, 'archive': 0 };

            Object.values(containers).forEach(c => c.innerHTML = '');
            const template = document.getElementById('kanbanCardTemplate');

            projects.forEach(project => {
                const status = project.status || 'upcoming';
                const container = containers[status];

                if (status === 'archive' && container) {
                    counts['archive']++;
                    const row = document.createElement('div');
                    row.className = 'kanban-card group flex items-center justify-between gap-2 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-md px-3 py-2 cursor-pointer';
                    row.draggable = true;
                    row.dataset.id = project.id;
                    row.dataset.status = status;
                    if (project.label && LABELS[project.label]) row.classList.add('label-' + project.label);
                    row.innerHTML = '<span class="text-sm text-zinc-700 dark:text-zinc-300 truncate flex-grow"></span>' +
                        '<button class="archive-delete shrink-0 text-red-400 hover:text-red-600 p-1.5 rounded-md hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors" title="Verwijderen"><i class="fa-regular fa-trash-can"></i></button>';
                    row.firstElementChild.textContent = project.title || 'Nieuw Project';
                    row.addEventListener('click', (e) => {
                        if (e.target.closest('.archive-delete')) return;
                        openProjectModal(project);
                    });
                    row.querySelector('.archive-delete').addEventListener('click', (e) => {
                        e.stopPropagation();
                        deleteProjectById(project.id, project.title);
                    });
                    setupDragAndDropForCard(row);
                    container.appendChild(row);
                    return;
                }

                if (container) {
                    counts[status]++;
                    const clone = template.content.cloneNode(true);
                    const cardElement = clone.querySelector('.kanban-card');

                    cardElement.dataset.id = project.id;
                    cardElement.dataset.status = status;
                    if (project.label && LABELS[project.label]) {
                        cardElement.classList.add('label-' + project.label);
                        const chip = clone.querySelector('.card-label-chip');
                        chip.textContent = LABELS[project.label];
                        chip.classList.add(project.label);
                        chip.classList.remove('hidden');
                    }
                    // compact-card
                    clone.querySelector('.card-title').textContent = project.title || 'Nieuw Project';

                    const checklist = project.checklist || [];
                    let total = 0, checked = 0;
                    checklist.forEach(item => {
                        total++; if (item.checked) checked++;
                        if (item.subitems) {
                            item.subitems.forEach(sub => { total++; if (sub.checked) checked++; });
                        }
                    });

                    const percent = total === 0 ? 0 : Math.round((checked / total) * 100);
                    clone.querySelector('.card-progress-text').textContent = `${checked}/${total}`;

                    const progressBar = clone.querySelector('.card-progress-bar');
                    progressBar.style.width = `${percent}%`;
                    if (percent === 100 && total > 0) {
                        progressBar.classList.replace('bg-zinc-800', 'bg-emerald-500');
                        progressBar.classList.replace('dark:bg-zinc-300', 'dark:bg-emerald-500');
                    }

                    const weekBadge = clone.querySelector('.card-week-badge');
                    if (project.weekNumber) {
                        weekBadge.textContent = `W${project.weekNumber}`;
                        weekBadge.classList.remove('hidden');
                    }

                    cardElement.addEventListener('click', (e) => {
                        if (e.target.closest('.drag-handle')) return;
                        openProjectModal(project);
                    });

                    setupDragAndDropForCard(cardElement);
                    container.appendChild(clone);
                }
            });

            document.querySelector('#col-upcoming .count-badge').textContent = counts['upcoming'];
            document.querySelector('#col-atelier .count-badge').textContent = counts['atelier'];
            document.querySelector('#col-done .count-badge').textContent = counts['done'];
            document.querySelector('#col-archive .count-badge').textContent = counts['archive'];
        }

        let draggedCard = null;
        function setupDragAndDropForCard(card) {
            card.addEventListener('dragstart', function (e) {
                draggedCard = this;
                setTimeout(() => this.classList.add('is-dragging'), 0);
                e.dataTransfer.effectAllowed = 'move';
                e.dataTransfer.setData('text/plain', this.dataset.id);
            });
            card.addEventListener('dragend', function (e) {
                this.classList.remove('is-dragging');
                draggedCard = null;
            });
        }
        document.querySelectorAll('.kanban-column').forEach(column => {
            column.addEventListener('dragover', e => e.preventDefault());
            column.addEventListener('drop', e => {
                e.preventDefault();
                if (draggedCard) {
                    const projectId = draggedCard.dataset.id;
                    const newStatus = column.dataset.status;
                    if (newStatus !== draggedCard.dataset.status) {
                        updateProjectField(projectId, { status: newStatus });
                    }
                }
            });
        });

        window.openStagingModal = function () {
            stagingTargetProjectId = null;
            setStagingMode(false);
            stagingImagesBase64 = [];
            renderStagingImages();
            showModal('stagingModal');
        }

        function setStagingMode(append) {
            document.getElementById('stagingTitle').textContent = append ? 'Fiche toevoegen aan project' : 'Nieuw Project Toevoegen';
            document.getElementById('btnEmptyProject').style.display = append ? 'none' : '';
        }

        window.openStagingModalForProject = function () {
            if (!activeProject) return;
            stagingImagesBase64 = [];
            stagingTargetProjectId = activeProject.id;
            setStagingMode(true);
            renderStagingImages();
            showModal('stagingModal');
        }

        window.createEmptyProject = function () {
            stagingTargetProjectId = null;
            stagingImagesBase64 = [];
            pendingProjectData = { title: '', checklist: [], images: [], targetId: null };
            document.getElementById('reviewImagesContainer').innerHTML = '';
            document.getElementById('reviewTitle').value = '';
            document.getElementById('reviewWeek').value = '';
            document.getElementById('reviewLabel').value = 'aframes';
            renderReviewChecklist();
            hideModal('stagingModal');
            showModal('reviewModal');
            setTimeout(() => document.getElementById('reviewTitle').focus(), 350);
        }

        function compressImage(file, callback) {
            const reader = new FileReader();
            reader.readAsDataURL(file);
            reader.onload = event => {
                const img = new Image();
                img.src = event.target.result;
                img.onload = () => {
                    const canvas = document.createElement('canvas');
                    const MAX_DIM = 1000;
                    let w = img.width, h = img.height;
                    if (w > h && w > MAX_DIM) { h *= MAX_DIM / w; w = MAX_DIM; }
                    else if (h > MAX_DIM) { w *= MAX_DIM / h; h = MAX_DIM; }
                    canvas.width = w; canvas.height = h;
                    canvas.getContext('2d').drawImage(img, 0, 0, w, h);
                    callback(canvas.toDataURL('image/jpeg', 0.6));
                }
            }
        }

        function renderStagingImages() {
            const container = document.getElementById('stagingImageContainer');
            const btnProcess = document.getElementById('btnProcessImages');
            container.innerHTML = '';

            if (stagingImagesBase64.length === 0) {
                container.innerHTML = '<div class="w-full h-32 flex items-center justify-center border-2 border-dashed border-zinc-300 dark:border-zinc-700 rounded-md text-zinc-400 dark:text-zinc-500">Nog geen foto\'s toegevoegd</div>';
                btnProcess.disabled = true;
                btnProcess.classList.add('opacity-50', 'cursor-not-allowed');
                return;
            }

            btnProcess.disabled = false;
            btnProcess.classList.remove('opacity-50', 'cursor-not-allowed');

            stagingImagesBase64.forEach((b64, idx) => {
                const div = document.createElement('div');
                div.className = "relative h-32 w-24 flex-shrink-0 rounded-md overflow-hidden border border-zinc-200 dark:border-zinc-700 group";
                div.innerHTML = `
                    <img src="${b64}" class="w-full h-full object-cover">
                    <button class="absolute top-1 right-1 bg-red-600 text-white rounded-md w-6 h-6 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity" onclick="removeStagingImage(${idx})">
                        <i class="fa-solid fa-times text-xs"></i>
                    </button>
                `;
                container.appendChild(div);
            });
        }

        window.removeStagingImage = function (index) {
            stagingImagesBase64.splice(index, 1);
            renderStagingImages();
        }

        async function processStagingImages() {
            if (stagingImagesBase64.length === 0) return;
            hideModal('stagingModal');
            showModal('processingModal');

            try {
                const token = await currentUser.getIdToken();

                const response = await fetch("/api/ai", {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({ images: stagingImagesBase64 })
                });

                if (!response.ok) {
                    const errorData = await response.json().catch(() => ({}));
                    throw new Error(errorData.error?.message || errorData.error || "API Fout");
                }

                const result = await response.json();

                if (result.candidates && result.candidates.length > 0) {
                    parseAIAndShowReview(result.candidates[0].content.parts[0].text);
                } else throw new Error("Ongeldig AI antwoord");

            } catch (error) {
                console.error(error);
                showToast("Fout bij AI verwerking: " + error.message, "error");
                hideModal('processingModal');
                showModal('stagingModal');
            }
        }

        function parseAIAndShowReview(text) {
            let title = "Nieuw Project";
            let itemsArray = [];

            try {
                let cleanText = text.replace(/```\w*\n/g, '').replace(/```/g, '').trim();

                const titleRegex = /1\.\s*De Titel\s*([\s\S]*?)(?=2\.\s*De Items|$)/i;
                const titleMatch = cleanText.match(titleRegex);

                let itemsText = cleanText;

                if (titleMatch) {
                    title = titleMatch[1].replace(/[\[\]]/g, '').trim();
                    const itemsMatch = cleanText.match(/2\.\s*De Items\s*([\s\S]*)$/i);
                    if (itemsMatch) itemsText = itemsMatch[1].trim();
                    else itemsText = cleanText.replace(titleMatch[0], '').trim();
                }

                itemsText = itemsText.replace(/[\[\]]/g, '');
                const lines = itemsText.split('\n').map(l => l.trim()).filter(l => l.length > 0);

                let currentItem = null;
                lines.forEach(line => {
                    if (line.match(/^P\d{6}\s*-/i)) {
                        if (title === "Nieuw Project" || title === "") title = line;
                        return;
                    }
                    if (line.match(/^1\.\s*De Titel/i) || line.match(/^2\.\s*De Items/i)) return;

                    if (line.startsWith('-') || line.startsWith('*')) {
                        const subText = line.replace(/^[-*\s]+/, '').trim();
                        if (currentItem) {
                            currentItem.subitems.push({ id: crypto.randomUUID(), text: subText, checked: false });
                        } else {
                            itemsArray.push({ id: crypto.randomUUID(), text: subText, checked: false, subitems: [] });
                            currentItem = itemsArray[itemsArray.length - 1];
                        }
                    } else {
                        currentItem = { id: crypto.randomUUID(), text: line, checked: false, subitems: [] };
                        itemsArray.push(currentItem);
                    }
                });
            } catch (e) {
                itemsArray = [{ id: crypto.randomUUID(), text: "Fout bij inlezen items", checked: false, subitems: [] }];
            }

            pendingProjectData = { title: title, checklist: itemsArray, images: [...stagingImagesBase64], targetId: stagingTargetProjectId };

            const imgContainer = document.getElementById('reviewImagesContainer');
            imgContainer.innerHTML = '';
            pendingProjectData.images.forEach(b64 => {
                const img = document.createElement('img');
                img.src = b64;
                img.className = "h-32 w-auto object-contain border border-zinc-300 dark:border-zinc-700 rounded-md bg-white dark:bg-black";
                imgContainer.appendChild(img);
            });

            document.getElementById('reviewTitle').value = title;
            document.getElementById('reviewWeek').value = '';
            document.getElementById('reviewLabel').value = 'aframes';
            if (stagingTargetProjectId) {
                const tp = projects.find(p => p.id === stagingTargetProjectId);
                if (tp) {
                    document.getElementById('reviewTitle').value = tp.title || '';
                    document.getElementById('reviewWeek').value = tp.weekNumber || '';
                    document.getElementById('reviewLabel').value = tp.label || '';
                }
            }
            renderReviewChecklist();

            hideModal('processingModal');
            showModal('reviewModal');
        }

        function renderReviewChecklist() {
            const container = document.getElementById('reviewChecklist');
            container.innerHTML = '';

            pendingProjectData.checklist.forEach((item, index) => {
                const itemDiv = document.createElement('div');
                itemDiv.className = "flex flex-col gap-2 p-3 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-md shadow-sm";

                const mainRow = document.createElement('div');
                mainRow.className = "flex gap-2 items-center";
                mainRow.innerHTML = `
                    <input type="text" value="${esc(item.text)}" class="font-semibold flex-grow p-1.5 text-sm border border-zinc-300 dark:border-zinc-700 rounded-md bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white focus:ring-1 focus:ring-zinc-900 dark:focus:ring-white outline-none">
                    <button class="text-zinc-500 hover:text-zinc-900 dark:hover:text-white p-1 text-sm" onclick="addReviewSubitem(${index})" title="Subitem toevoegen"><i class="fa-solid fa-plus"></i></button>
                    <button class="text-red-500 hover:text-red-700 p-1" onclick="removeReviewItem(${index})"><i class="fa-solid fa-trash-can"></i></button>
                `;
                mainRow.querySelector('input').addEventListener('change', e => pendingProjectData.checklist[index].text = e.target.value);
                itemDiv.appendChild(mainRow);

                if (item.subitems && item.subitems.length > 0) {
                    const subContainer = document.createElement('div');
                    subContainer.className = "ml-6 pl-2 border-l-2 border-zinc-200 dark:border-zinc-800 space-y-2";
                    item.subitems.forEach((sub, subIdx) => {
                        const subRow = document.createElement('div');
                        subRow.className = "flex gap-2 items-center";
                        subRow.innerHTML = `
                            <div class="text-zinc-400">-</div>
                            <input type="text" value="${esc(sub.text)}" class="flex-grow p-1 text-sm border border-zinc-300 dark:border-zinc-700 rounded-md bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white focus:ring-1 focus:ring-zinc-900 dark:focus:ring-white outline-none">
                            <button class="text-red-500 hover:text-red-700 p-1 text-xs" onclick="removeReviewSubitem(${index}, ${subIdx})"><i class="fa-solid fa-times"></i></button>
                        `;
                        subRow.querySelector('input').addEventListener('change', e => pendingProjectData.checklist[index].subitems[subIdx].text = e.target.value);
                        subContainer.appendChild(subRow);
                    });
                    itemDiv.appendChild(subContainer);
                }
                container.appendChild(itemDiv);
            });
        }

        window.addReviewItem = function () {
            pendingProjectData.checklist.push({ id: crypto.randomUUID(), text: "", checked: false, subitems: [] });
            renderReviewChecklist();
        }
        window.removeReviewItem = function (index) {
            pendingProjectData.checklist.splice(index, 1);
            renderReviewChecklist();
        }
        window.addReviewSubitem = function (index) {
            pendingProjectData.checklist[index].subitems.push({ id: crypto.randomUUID(), text: "", checked: false });
            renderReviewChecklist();
        }
        window.removeReviewSubitem = function (mainIndex, subIndex) {
            pendingProjectData.checklist[mainIndex].subitems.splice(subIndex, 1);
            renderReviewChecklist();
        }

        async function saveNewProjectToDB() {
            if (!currentUser || !pendingProjectData) return;
            const finalTitle = document.getElementById('reviewTitle').value.trim() || 'Onbekend Project';
            const weekNumber = document.getElementById('reviewWeek').value.trim();
            const label = document.getElementById('reviewLabel').value;

            const cleanedChecklist = pendingProjectData.checklist.filter(i => i.text.trim().length > 0).map(i => ({
                ...i,
                subitems: i.subitems.filter(s => s.text.trim().length > 0)
            }));
            if (label === 'extern' && !hasSteekrubber(cleanedChecklist) && !(pendingProjectData.targetId && hasSteekrubber((projects.find(p => p.id === pendingProjectData.targetId) || {}).checklist || []))) cleanedChecklist.push(newSteekrubberItem());

            const targetProject = pendingProjectData.targetId ? projects.find(p => p.id === pendingProjectData.targetId) : null;
            if (pendingProjectData.targetId && !targetProject) { showToast("Project niet meer gevonden", "error"); return; }
            let finalChecklist = cleanedChecklist;
            let finalImages = pendingProjectData.images;
            if (targetProject) {
                finalChecklist = [...(targetProject.checklist || []), ...cleanedChecklist];
                finalImages = [...(targetProject.images || (targetProject.imageBase64 ? [targetProject.imageBase64] : [])), ...pendingProjectData.images];
            }
            const approxSize = JSON.stringify({ checklist: finalChecklist, images: finalImages }).length;
            if (approxSize > 950000) {
                showToast("Foto's zijn samen te groot (max ±1 MB per project). Gebruik minder foto's.", "error");
                return;
            }

            const btn = document.getElementById('btnSaveNewProject');
            btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';

            try {
                if (targetProject) {
                    const upd = { checklist: finalChecklist, images: finalImages };
                    if (finalTitle !== (targetProject.title || '')) upd.title = finalTitle;
                    if (weekNumber !== String(targetProject.weekNumber || '')) upd.weekNumber = weekNumber;
                    if (label !== (targetProject.label || '')) upd.label = label;
                    await updateDoc(projectDoc(targetProject.id), upd);
                } else await addDoc(projectsCol(), {
                    title: finalTitle,
                    weekNumber: weekNumber,
                    checklist: cleanedChecklist,
                    images: pendingProjectData.images,
                    status: 'upcoming',
                    label: label,
                    createdAt: serverTimestamp()
                });
                hideModal('reviewModal');
                showToast(targetProject ? "Fiche toegevoegd!" : "Project aangemaakt!", "success");
                stagingTargetProjectId = null;
                pendingProjectData = null;
                stagingImagesBase64 = [];
            } catch (e) {
                showToast("Fout bij opslaan: " + (e.code || e.message), "error");
            } finally {
                btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-check"></i><span>Opslaan op Bord</span>';
            }
        }

        function openProjectModal(project) {
            activeProject = project;
            document.getElementById('modalProjectTitle').innerText = project.title;
            document.getElementById('modalProjectImagesContainer').dataset.key = '';

            const imgContainer = document.getElementById('modalProjectImagesContainer');
            imgContainer.innerHTML = '';
            const images = project.images || (project.imageBase64 ? [project.imageBase64] : []);
            images.forEach(b64 => {
                const img = document.createElement('img');
                img.src = b64;
                img.className = "w-full max-h-[70vh] object-contain bg-white dark:bg-black border border-zinc-200 dark:border-zinc-800 shadow-sm rounded-md";
                imgContainer.appendChild(img);
            });

            document.getElementById('modalProjectStatus').value = project.status || 'upcoming';
            document.getElementById('modalProjectWeek').value = project.weekNumber || '';
            document.getElementById('modalProjectLabel').value = project.label || '';
            renderActiveProjectLiveChecklist();
            renderActiveProjectImages();
            showModal('projectModal');
        }

        function createCheckboxHTML(item, isSub = false, parentId = null) {
            const hasLD = /\bB\d{6}\b/i.test(item.text);

            let extraCheckboxes = '';
            if (hasLD) {
                extraCheckboxes = `
                <div class="flex flex-col ml-3 pl-3 border-l border-zinc-200 dark:border-zinc-700 shrink-0 justify-center">
                    <label class="flex items-center gap-2 cursor-pointer group/extra">
                        <div class="relative w-4 h-4 rounded-sm border border-zinc-400 dark:border-zinc-500 bg-white dark:bg-zinc-800 flex items-center justify-center">
                            <input type="checkbox" class="absolute opacity-0 inset-0 cursor-pointer z-10" ${item.delivered ? 'checked' : ''} onchange="toggleExtraStatus('${item.id}', 'delivered', this.checked, ${isSub ? `'${parentId}'` : 'null'})">
                            <div class="absolute inset-0 rounded-sm flex items-center justify-center pointer-events-none transition-colors ${item.delivered ? 'bg-zinc-800 dark:bg-zinc-200 border-zinc-800 dark:border-zinc-200' : ''}">
                                ${item.delivered ? '<i class="fa-solid fa-check text-[10px] text-white dark:text-zinc-900"></i>' : ''}
                            </div>
                        </div>
                        <span class="text-xs font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider group-hover/extra:text-zinc-900 dark:group-hover/extra:text-zinc-200 transition-colors">Geleverd</span>
                    </label>
                </div>
                `;
            }

            const mainCheckboxVisual = item.checked
                ? '<div class="absolute inset-0 rounded-sm flex items-center justify-center bg-emerald-500 border-emerald-500"><svg class="w-3.5 h-3.5 text-white pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg></div>'
                : '<div class="absolute inset-0 rounded-sm flex items-center justify-center"></div>';

            return `
                <div class="flex items-start justify-between p-2.5 rounded-md border ${isSub ? 'border-transparent hover:bg-zinc-50 dark:hover:bg-zinc-800/50' : 'border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-sm'} group min-w-0">
                    <span class="cl-grip shrink-0 text-zinc-300 hover:text-zinc-700 dark:text-zinc-600 dark:hover:text-zinc-300 px-1.5 pt-1 select-none" title="Slepen om te verplaatsen"><i class="fa-solid fa-grip-vertical text-xs"></i></span>
                    <label class="flex-grow flex items-start gap-3 cursor-pointer min-w-0">
                        <div class="relative flex items-center justify-center w-5 h-5 mt-0.5 rounded-sm border-2 border-zinc-300 dark:border-zinc-600 bg-white dark:bg-zinc-800 flex-shrink-0">
                            <input type="checkbox" class="opacity-0 absolute inset-0 cursor-pointer w-full h-full z-10" ${item.checked ? 'checked' : ''} onchange="toggleItemStatus('${item.id}', this.checked, ${isSub ? `'${parentId}'` : 'null'})">
                            ${mainCheckboxVisual}
                        </div>
                        <div class="flex-grow flex justify-between items-center min-h-[20px] min-w-0 pt-0.5 pr-2">
                            <span class="text-sm ${isSub ? 'text-zinc-600 dark:text-zinc-300' : 'font-medium text-zinc-900 dark:text-zinc-100'} transition-colors break-words leading-tight ${item.checked ? 'item-checked' : ''}" ondblclick="editItemText('${item.id}', ${isSub ? `'${parentId}'` : 'null'})" title="Dubbelklik om te bewerken">${esc(item.text)}</span>
                        </div>
                    </label>
                    <div class="flex items-center shrink-0 gap-1">
                        <button onclick="event.preventDefault(); editItemText('${item.id}', ${isSub ? `'${parentId}'` : 'null'})" class="opacity-0 group-hover:opacity-100 text-zinc-400 hover:text-zinc-900 dark:hover:text-white p-1.5 rounded-md hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-all" title="Tekst bewerken"><i class="fa-solid fa-pen text-xs"></i></button>
                        ${!isSub ? `<button onclick="event.preventDefault(); addNewSubItemToLiveProject('${item.id}')" class="opacity-0 group-hover:opacity-100 text-zinc-400 hover:text-zinc-900 dark:hover:text-white p-1.5 rounded-md hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-all" title="Subitem toevoegen"><i class="fa-solid fa-plus text-sm"></i></button>` : ''}
                        <button onclick="event.preventDefault(); deleteItemFromLiveProject('${item.id}', ${isSub ? `'${parentId}'` : 'null'})" class="opacity-0 group-hover:opacity-100 text-red-400 hover:text-red-600 dark:hover:text-red-400 p-1.5 rounded-md hover:bg-red-50 dark:hover:bg-red-900/20 transition-all" title="Verwijderen"><i class="fa-solid fa-trash-can text-sm"></i></button>
                        ${extraCheckboxes}
                    </div>
                </div>
            `;
        }

        function renderActiveProjectLiveChecklist() {
            if (!activeProject) return;
            const container = document.getElementById('liveChecklist');
            container.innerHTML = '';

            let total = 0, checkedCount = 0;
            const checklist = activeProject.checklist || [];

            checklist.forEach(item => {
                total++; if (item.checked) checkedCount++;
                const itemDiv = document.createElement('div');
                itemDiv.className = 'cl-main';
                itemDiv.dataset.id = item.id;
                itemDiv.innerHTML = createCheckboxHTML(item, false);

                if (item.subitems && item.subitems.length > 0) {
                    const subContainer = document.createElement('div');
                    subContainer.className = "ml-7 space-y-1 mt-1 pl-2 border-l-2 border-zinc-200 dark:border-zinc-800";
                    subContainer.dataset.parent = item.id;
                    item.subitems.forEach(sub => {
                        total++; if (sub.checked) checkedCount++;
                        const subDiv = document.createElement('div');
                        subDiv.className = 'cl-sub';
                        subDiv.dataset.id = sub.id;
                        subDiv.innerHTML = createCheckboxHTML(sub, true, item.id);
                        subContainer.appendChild(subDiv);
                    });
                    itemDiv.appendChild(subContainer);
                }
                container.appendChild(itemDiv);
            });

            document.getElementById('modalProjectProgress').innerText = `${checkedCount}/${total}`;
            if (total === 0) container.innerHTML = '<div class="text-center p-4 text-zinc-500">Geen items.</div>';
        }

        function renderActiveProjectImages() {
            if (!activeProject) return;
            const c = document.getElementById('modalProjectImagesContainer');
            const images = activeProject.images || (activeProject.imageBase64 ? [activeProject.imageBase64] : []);
            const key = activeProject.id + ':' + images.length;
            if (c.dataset.key === key) return;
            c.dataset.key = key;
            c.innerHTML = '';
            if (images.length === 0) {
                c.innerHTML = '<div class="m-auto text-sm text-zinc-500 dark:text-zinc-400 text-center p-4">Nog geen fiches. Gebruik "Fiche toevoegen" bij de checklist.</div>';
                return;
            }
            images.forEach(b64 => {
                const img = document.createElement('img');
                img.src = b64;
                img.className = "w-full max-h-[70vh] object-contain bg-white dark:bg-black border border-zinc-200 dark:border-zinc-800 shadow-sm rounded-md";
                c.appendChild(img);
            });
        }

        // Volgorde wijzigen via sleephandvat (werkt met muis en touch)
        (function setupChecklistSort() {
            const list = document.getElementById('liveChecklist');
            let drag = null;

            list.addEventListener('pointerdown', (e) => {
                const grip = e.target.closest('.cl-grip');
                if (!grip) return;
                const el = grip.closest('.cl-main, .cl-sub');
                if (!el) return;
                e.preventDefault();
                try { grip.setPointerCapture(e.pointerId); } catch (_) { }
                drag = { el, container: el.parentElement, parentId: el.classList.contains('cl-sub') ? el.parentElement.dataset.parent : null };
                el.classList.add('is-sorting');
            });

            list.addEventListener('pointermove', (e) => {
                if (!drag || !drag.el.isConnected) return;
                const siblings = Array.from(drag.container.children).filter(c => c !== drag.el);
                for (const sib of siblings) {
                    const r = sib.getBoundingClientRect();
                    if (e.clientY >= r.top && e.clientY <= r.bottom) {
                        const before = e.clientY < r.top + r.height / 2;
                        drag.container.insertBefore(drag.el, before ? sib : sib.nextSibling);
                        break;
                    }
                }
            });

            const end = async () => {
                if (!drag) return;
                const d = drag;
                drag = null;
                d.el.classList.remove('is-sorting');
                await saveChecklistOrder(d.parentId);
            };
            list.addEventListener('pointerup', end);
            list.addEventListener('pointercancel', end);

            async function saveChecklistOrder(parentId) {
                if (!currentUser || !activeProject) return;
                const cl = JSON.parse(JSON.stringify(activeProject.checklist || []));
                let next;
                if (parentId) {
                    const parent = cl.find(i => i.id === parentId);
                    const sc = Array.from(list.querySelectorAll('[data-parent]')).find(x => x.dataset.parent === parentId);
                    if (!parent || !sc) return;
                    const subs = new Map((parent.subitems || []).map(s => [s.id, s]));
                    const ordered = Array.from(sc.children).map(c => subs.get(c.dataset.id)).filter(Boolean);
                    if (ordered.length !== (parent.subitems || []).length) return;
                    parent.subitems = ordered;
                    next = cl;
                } else {
                    const byId = new Map(cl.map(i => [i.id, i]));
                    next = Array.from(list.children).map(c => byId.get(c.dataset.id)).filter(Boolean);
                    if (next.length !== cl.length) return;
                }
                if (JSON.stringify(next) === JSON.stringify(activeProject.checklist || [])) return;
                try { await updateDoc(projectDoc(activeProject.id), { checklist: next }); }
                catch (e) { showToast("Fout bij opslaan volgorde", "error"); renderActiveProjectLiveChecklist(); }
            }
        })();

        window.toggleItemStatus = async function (itemId, isChecked, parentId) {
            if (!currentUser || !activeProject) return;

            let updatedChecklist = JSON.parse(JSON.stringify(activeProject.checklist));

            if (parentId) {
                const parent = updatedChecklist.find(i => i.id === parentId);
                if (parent) {
                    const sub = parent.subitems.find(s => s.id === itemId);
                    if (sub) sub.checked = isChecked;
                }
            } else {
                const item = updatedChecklist.find(i => i.id === itemId);
                if (item) { item.checked = isChecked; (item.subitems || []).forEach(s => { s.checked = isChecked; }); }
            }

            try {
                const docRef = projectDoc(activeProject.id);
                await updateDoc(docRef, { checklist: updatedChecklist });

                let allDone = true;
                updatedChecklist.forEach(i => {
                    if (!i.checked) allDone = false;
                    if (i.subitems) i.subitems.forEach(s => { if (!s.checked) allDone = false; });
                });

                if (allDone && updatedChecklist.length > 0 && activeProject.status !== 'done' && activeProject.status !== 'archive') {
                    await updateDoc(docRef, { status: 'done' });
                    showToast("Alle items afgevinkt! Verplaatst naar Gereed.", "success");
                }
            } catch (e) { console.error(e); }
        }

        window.toggleExtraStatus = async function (itemId, field, isChecked, parentId) {
            if (!currentUser || !activeProject) return;
            let updatedChecklist = JSON.parse(JSON.stringify(activeProject.checklist));
            if (parentId) {
                const parent = updatedChecklist.find(i => i.id === parentId);
                if (parent) {
                    const sub = parent.subitems.find(s => s.id === itemId);
                    if (sub) sub[field] = isChecked;
                }
            } else {
                const item = updatedChecklist.find(i => i.id === itemId);
                if (item) item[field] = isChecked;
            }
            try { await updateDoc(projectDoc(activeProject.id), { checklist: updatedChecklist }); } catch (e) { }
        }

        window.openCustomDialog = function (options) {
            return new Promise((resolve) => {
                const modal = document.getElementById('customDialogModal');
                const titleEl = document.getElementById('dialogTitle');
                const msgEl = document.getElementById('dialogMessage');
                const inputEl = document.getElementById('dialogInput');
                const btnCancel = document.getElementById('btnDialogCancel');
                const btnConfirm = document.getElementById('btnDialogConfirm');

                titleEl.textContent = options.title || 'Melding';

                if (options.message) {
                    msgEl.textContent = options.message;
                    msgEl.classList.remove('hidden');
                } else {
                    msgEl.classList.add('hidden');
                }

                if (options.type === 'prompt') {
                    inputEl.value = options.defaultValue || '';
                    inputEl.classList.remove('hidden');
                    setTimeout(() => inputEl.focus(), 100);
                } else {
                    inputEl.classList.add('hidden');
                }

                if (options.isDanger) {
                    btnConfirm.className = "bg-red-600 text-white hover:bg-red-700 px-4 py-2 rounded-md text-sm font-medium shadow transition-colors";
                } else {
                    btnConfirm.className = "bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 hover:bg-zinc-800 dark:hover:bg-zinc-200 px-4 py-2 rounded-md text-sm font-medium shadow transition-colors";
                }

                btnConfirm.textContent = options.confirmText || 'Bevestigen';

                const cleanup = () => {
                    btnConfirm.removeEventListener('click', onConfirm);
                    btnCancel.removeEventListener('click', onCancel);
                    inputEl.removeEventListener('keydown', onEnter);
                    hideModal('customDialogModal');
                };

                const onConfirm = () => {
                    cleanup();
                    if (options.type === 'prompt') resolve(inputEl.value);
                    else resolve(true);
                };

                const onCancel = () => {
                    cleanup();
                    resolve(null);
                };

                const onEnter = (e) => {
                    if (e.key === 'Enter') onConfirm();
                }

                btnConfirm.addEventListener('click', onConfirm);
                btnCancel.addEventListener('click', onCancel);
                inputEl.addEventListener('keydown', onEnter);

                showModal('customDialogModal');
            });
        }

        window.editItemText = async function (itemId, parentId) {
            const list = activeProject.checklist || [];
            const currentText = parentId
                ? (list.find(i => i.id === parentId)?.subitems?.find(s => s.id === itemId)?.text || '')
                : (list.find(i => i.id === itemId)?.text || '');
            const newText = await window.openCustomDialog({
                title: 'Bewerk tekst',
                type: 'prompt',
                defaultValue: currentText,
                confirmText: 'Opslaan'
            });
            if (newText === null || newText.trim() === "") return;

            let updatedChecklist = JSON.parse(JSON.stringify(activeProject.checklist));
            if (parentId) {
                const p = updatedChecklist.find(i => i.id === parentId);
                if (p) { const s = p.subitems.find(x => x.id === itemId); if (s) s.text = newText.trim(); }
            } else {
                const i = updatedChecklist.find(x => x.id === itemId); if (i) i.text = newText.trim();
            }
            try { await updateDoc(projectDoc(activeProject.id), { checklist: updatedChecklist }); } catch (e) { }
        }

        window.addNewMainItemToLiveProject = async function () {
            if (!activeProject || !currentUser) return;
            const newText = await window.openCustomDialog({
                title: 'Nieuw hoofdpunt toevoegen',
                type: 'prompt',
                confirmText: 'Toevoegen'
            });
            if (newText === null || newText.trim() === "") return;

            const updatedChecklist = [...(activeProject.checklist || []), { id: crypto.randomUUID(), text: newText.trim(), checked: false, subitems: [] }];
            try { await updateDoc(projectDoc(activeProject.id), { checklist: updatedChecklist }); } catch (e) { }
        }

        window.addNewSubItemToLiveProject = async function (parentId) {
            if (!activeProject || !currentUser) return;
            const newText = await window.openCustomDialog({
                title: 'Nieuw subitem toevoegen',
                type: 'prompt',
                confirmText: 'Toevoegen'
            });
            if (newText === null || newText.trim() === "") return;

            let updatedChecklist = JSON.parse(JSON.stringify(activeProject.checklist));
            const parent = updatedChecklist.find(i => i.id === parentId);
            if (parent) {
                if (!parent.subitems) parent.subitems = [];
                parent.subitems.push({ id: crypto.randomUUID(), text: newText.trim(), checked: false });
                try { await updateDoc(projectDoc(activeProject.id), { checklist: updatedChecklist }); } catch (e) { }
            }
        }

        window.deleteItemFromLiveProject = async function (itemId, parentId) {
            if (!activeProject || !currentUser) return;

            const confirmDelete = await window.openCustomDialog({
                title: 'Item verwijderen',
                message: 'Weet je zeker dat je dit item wilt verwijderen?',
                type: 'confirm',
                isDanger: true,
                confirmText: 'Verwijderen'
            });

            if (!confirmDelete) return;

            let updatedChecklist = JSON.parse(JSON.stringify(activeProject.checklist));

            if (parentId) {
                const parent = updatedChecklist.find(i => i.id === parentId);
                if (parent) {
                    parent.subitems = parent.subitems.filter(s => s.id !== itemId);
                }
            } else {
                updatedChecklist = updatedChecklist.filter(i => i.id !== itemId);
            }

            try {
                await updateDoc(projectDoc(activeProject.id), { checklist: updatedChecklist });
            } catch (e) {
                showToast("Fout bij verwijderen", "error");
            }
        }

        async function deleteProjectById(id, title) {
            if (!currentUser) return;
            const ok = await window.openCustomDialog({
                title: 'Project verwijderen',
                message: '"' + (title || 'Project') + '" definitief verwijderen? Dit kan niet ongedaan worden gemaakt.',
                type: 'confirm',
                isDanger: true,
                confirmText: 'Verwijderen'
            });
            if (!ok) return;
            try {
                await deleteDoc(projectDoc(id));
                showToast("Project verwijderd", "success");
            } catch (e) { showToast("Fout bij verwijderen: " + (e.code || e.message), "error"); }
        }

        async function deleteActiveProject() {
            if (!activeProject || !currentUser) return;

            const confirmDelete = await window.openCustomDialog({
                title: 'Project verwijderen',
                message: 'Weet je zeker dat je dit project wil verwijderen? Dit kan niet ongedaan worden gemaakt.',
                type: 'confirm',
                isDanger: true,
                confirmText: 'Verwijderen'
            });

            if (!confirmDelete) return;

            try {
                await deleteDoc(projectDoc(activeProject.id));
                hideModal('projectModal');
                showToast("Project verwijderd", "success");
                activeProject = null;
            } catch (e) { showToast("Fout bij verwijderen", "error"); }
        }

        function showModal(id) {
            const modal = document.getElementById(id);
            const content = modal.querySelector('div[class*="scale"]');
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                if (content) { content.classList.remove('scale-95'); content.classList.add('scale-100'); }
            }, 10);
        }

        window.hideModal = function (id) {
            const modal = document.getElementById(id);
            const content = modal.querySelector('div[class*="scale"]');
            modal.classList.add('opacity-0');
            if (content) { content.classList.remove('scale-100'); content.classList.add('scale-95'); }
            setTimeout(() => modal.classList.add('hidden'), 300);
        }

        function showToast(message, type = 'info') {
            const toast = document.getElementById('toast');
            document.getElementById('toastMessage').innerText = message;
            const icon = document.getElementById('toastIcon');

            toast.className = `fixed bottom-4 right-4 text-white px-4 py-3 rounded-md shadow-xl transform transition-transform duration-300 z-[100] flex items-center gap-3 font-medium border ${type === 'error' ? 'bg-red-600 border-red-500' : type === 'success' ? 'bg-emerald-600 border-emerald-500' : 'bg-zinc-900 border-zinc-700 dark:bg-zinc-800 dark:border-zinc-700'}`;
            icon.className = `fa-solid ${type === 'error' ? 'fa-triangle-exclamation text-white' : type === 'success' ? 'fa-check-circle text-white' : 'fa-info-circle text-zinc-300'}`;

            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => toast.classList.add('translate-y-20', 'opacity-0'), 3000);
        }
    </script>
</body>

</html>